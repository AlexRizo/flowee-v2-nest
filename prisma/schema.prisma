// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DESIGNER_ADMIN
  DESIGNER
  PUBLISHER_ADMIN
  PUBLISHER
  READER
}

// ? Usuarios

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  username      String      @unique
  avatar        String?
  role          Role        @default(READER)
  password      String
  isActive      Boolean     @default(true)
  refreshToken  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userBoard     UserBoard[]
  authorTasks   Task[]      @relation("AuthorTasks")
  assignedTasks Task[]      @relation("AssignedTasks")
  deleted       Boolean     @default(false)
}

// ? Tableros

model Board {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique
  prefix    String
  color     String      @default("#000000")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userBoard UserBoard[]
  tasks     Task[]
}

model UserBoard {
  id        String   @id @default(uuid())
  userId    String
  boardId   String
  user      User     @relation(fields: [userId], references: [id])
  board     Board    @relation(fields: [boardId], references: [id])
  createdAt DateTime @default(now())
}

// ? Tareas

enum TaskStatus {
  PENDING
  ATTENTION
  IN_PROGRESS
  FOR_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskType {
  PRINT
  DIGITAL
  ECOMMERCE
  SPECIAL
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(NORMAL)
  type         TaskType     @default(DIGITAL)
  // * Relaciones con usuarios
  authorId     String
  author       User         @relation("AuthorTasks", fields: [authorId], references: [id])
  assignedToId String?
  assignedTo   User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])
  // * Relacion con tablero
  boardId      String
  board        Board        @relation(fields: [boardId], references: [id])

  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // * Relación con los tipos de tarea
  printTask     PrintTask?
  digitalTask   DigitalTask?
  ecommerceTask EcommerceTask?
  specialTask   SpecialTask?
  taskFiles     TaskFiles[]
}

model PrintTask {
  id   String @id
  task Task   @relation(fields: [id], references: [id])
}

model DigitalTask {
  id   String @id
  task Task   @relation(fields: [id], references: [id])
}

model EcommerceTask {
  id   String @id
  task Task   @relation(fields: [id], references: [id])
}

model SpecialTask {
  id     String  @id
  task   Task    @relation(fields: [id], references: [id])
  size   String
  legals String?
}

// ? Archivos de las tareas

enum TaskFileType {
  REQUIRED
  REFERENCE
}

model TaskFiles {
  id        String       @id @default(uuid())
  key       String       @unique
  url       String
  fileName  String
  createdAt DateTime     @default(now())
  type      TaskFileType

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
